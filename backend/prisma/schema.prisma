  scoreEntryDueAt              DateTime? @map("score_entry_due_at")
  paperSubmissionUnlockedUntil DateTime? @map("paper_submission_unlocked_until")
  scoreEntryUnlockedUntil      DateTime? @map("score_entry_unlocked_until")
