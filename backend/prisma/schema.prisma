model ReportCard {
  id                String           @id @default(uuid())
  schoolId          String           @map("school_id")
  branchId          String           @map("branch_id")
  academicYearId    String           @map("academic_year_id")
  studentId         String           @map("student_id")
  gradeId           String           @map("grade_id")
  sectionId         String           @map("section_id")
  termLabel         String           @map("term_label")
  examTitle         String?          @map("exam_title")
  templateCode      String?          @map("template_code")
  streamLabel       String?          @map("stream_label")
  fatherName        String?          @map("father_name")
  overallGrade      String?          @map("overall_grade")
  rank              Int?
  totalMax          Decimal?         @map("total_max") @db.Decimal(7, 2)
  totalObtained     Decimal?         @map("total_obtained") @db.Decimal(7, 2)
  overallPercentage Decimal          @map("overall_percentage") @db.Decimal(5, 2)
  attendanceRate    Decimal          @map("attendance_rate") @db.Decimal(5, 2)
  remarks           String?          @db.Text
  status            ReportCardStatus @default(PUBLISHED)
  generatedById     String           @map("generated_by_id")
  generatedAt       DateTime         @default(now()) @map("generated_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id])
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade        Grade            @relation(fields: [gradeId], references: [id])
  section      Section          @relation(fields: [sectionId], references: [id])
  generatedBy  User             @relation("ReportGeneratedBy", fields: [generatedById], references: [id])
  lines        ReportCardLine[]

  @@unique([studentId, academicYearId, termLabel])
  @@index([schoolId])
  @@index([sectionId])
  @@map("report_cards")
}

model ReportCardLine {
  id             String   @id @default(uuid())
  reportCardId   String   @map("report_card_id")
  subjectId      String?  @map("subject_id")
  title          String   @default("")
  maxMarks       Decimal? @map("max_marks") @db.Decimal(6, 2)
  obtainedMarks  Decimal? @map("obtained_marks") @db.Decimal(6, 2)
  remarks        String?
  includeInTotal Boolean  @default(true) @map("include_in_total")
  sortOrder      Int      @default(0) @map("sort_order")
  average        Decimal  @db.Decimal(5, 2)
  quizzesTaken   Int      @map("quizzes_taken")
  gradeLetter    String   @map("grade_letter")

  reportCard ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject    Subject?   @relation(fields: [subjectId], references: [id])

  @@index([reportCardId])
  @@map("report_card_lines")
}

model ReportCardTemplate {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  code           String
  examTitle      String   @map("exam_title")
  classLabel     String   @map("class_label")
  totalMarks     Int      @map("total_marks")
  showRank       Boolean  @default(true) @map("show_rank")
  showStream     Boolean  @default(false) @map("show_stream")
  showFatherName Boolean  @default(false) @map("show_father_name")
  showDate       Boolean  @default(true) @map("show_date")
  showGradingKey Boolean  @default(false) @map("show_grading_key")
  showMonthYear  Boolean  @default(false) @map("show_month_year")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lines  ReportCardTemplateLine[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("report_card_templates")
}

model ReportCardTemplateLine {
  id             String  @id @default(uuid())
  templateId     String  @map("template_id")
  sortOrder      Int     @map("sort_order")
  label          String
  maxMarks       Int?    @map("max_marks")
  matchSubject   String  @map("match_subject")
  choiceGroup    String? @map("choice_group")
  includeInTotal Boolean @default(true) @map("include_in_total")

  template ReportCardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("report_card_template_lines")
}

