}

// ===================== AUTH =====================

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  username           String?    @unique
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  phone              String?
  employeeCode       String?    @map("employee_code") @db.VarChar(40)
  status             UserStatus @default(ACTIVE)
  schoolId           String?    @map("school_id")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  lastLoginAt        DateTime?  @map("last_login_at")
  permissions        Json?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  school                      School?                        @relation(fields: [schoolId], references: [id])
  roles                       UserRole[]
  refreshTokens               RefreshToken[]
  teacherProfile              TeacherProfile?
  parentProfile               ParentProfile?
  uploadedFiles               FileAsset[]                    @relation("UploadedBy")
  uploadedStudentPhotos       StudentPhotoAsset[]            @relation("StudentPhotoUploadedBy")
  reviewedStudentPhotos       StudentPhotoAsset[]            @relation("StudentPhotoReviewedBy")
  reviewedDayOffRequests      ParentDayOffRequest[]          @relation("DayOffReviewedBy")
  auditLogs                   AuditLog[]
  apiExceptionLogs            ApiExceptionLog[]
  aiRequests                  AIRequest[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  deviceTokens                DeviceToken[]
  createdQuizzes              Quiz[]                         @relation("QuizCreatedBy")
  reviewedQuizzes             Quiz[]                         @relation("QuizReviewedBy")
  examPaperAssignments        ExamPaperAssignment[]          @relation("ExamPaperAssignedBy")
  reviewedDeadlineExtensions  ExamDeadlineExtensionRequest[] @relation("DeadlineExtensionReviewedBy")
  createdHomework             Homework[]                     @relation("HomeworkCreatedBy")
  createdAnnouncements        Announcement[]                 @relation("AnnouncementCreatedBy")
  createdEvents               Event[]                        @relation("EventCreatedBy")
  createdLessons              DailyLesson[]                  @relation("LessonCreatedBy")
  createdLibraryBooks         LibraryBook[]                  @relation("LibraryBookCreatedBy")
  createdDiaries              HomeDiary[]                    @relation("DiaryCreatedBy")
  recordedFeePayments         FeePayment[]                   @relation("FeeRecordedBy")
  generatedReportCards        ReportCard[]                   @relation("ReportGeneratedBy")
  generatedIdCards            IdCard[]                       @relation("IdCardGeneratedBy")
  recordedExpenses            Expense[]                      @relation("ExpenseRecordedBy")
  recordedAssessments         AssessmentMark[]               @relation("AssessmentRecordedBy")
  recordedTeacherAttendance   TeacherAttendance[]            @relation("TeacherAttendanceRecordedBy")
  staffAttendances            StaffAttendance[]              @relation("StaffAttendanceUser")
  recordedStaffAttendance     StaffAttendance[]              @relation("StaffAttendanceRecordedBy")
  biometricStaffMappings      BiometricDeviceUserMapping[]   @relation("BiometricStaffMapping")
  verifiedLessonSources       LessonSource[]                 @relation("LessonSourceVerifiedBy")
  approvedOcrTrainingExamples OcrTrainingExample[]           @relation("OcrTrainingApprovedBy")

  @@unique([schoolId, employeeCode])
  @@index([schoolId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  schoolId  String?  @map("school_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id])

  @@unique([userId, roleId, schoolId])
  @@index([userId])
  @@index([roleId])
  @@index([schoolId])
  @@map("user_roles")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ===================== PLATFORM =====================

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  schoolId    String?  @map("school_id")
  branchId    String?  @map("branch_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  actor  User?   @relation(fields: [actorUserId], references: [id])
  school School? @relation(fields: [schoolId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([actorUserId])
  @@index([schoolId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ApiExceptionLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  schoolId   String?  @map("school_id")
  method     String   @db.VarChar(16)
  path       String   @db.VarChar(512)
  statusCode Int      @map("status_code")
  errorCode  String   @map("error_code") @db.VarChar(120)
  message    String   @db.Text
  details    Json?
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([statusCode])
  @@index([schoolId])
  @@index([userId])
  @@index([errorCode])
  @@map("api_exception_logs")
}

// ===================== SCHOOL =====================

model School {
  id                String       @id @default(uuid())
  name              String
  code              String       @unique
  email             String
  phone             String?
  address           String?
  city              String?
  country           String?
  logo              String?
  status            SchoolStatus @default(ACTIVE)
  syncApiKey        String?      @unique @map("sync_api_key") @db.VarChar(120)
  autoCheckoutHours Int?         @default(24) @map("auto_checkout_hours")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  branches                      Branch[]
  settings                      SchoolSettings?
  subscription                  SchoolSubscription?
  users                         User[]
  userRoles                     UserRole[]
  students                      Student[]
  parents                       ParentProfile[]
  dayOffRequests                ParentDayOffRequest[]
  studentPhotoAssets            StudentPhotoAsset[]
  teachers                      TeacherProfile[]
  academicYears                 AcademicYear[]
  grades                        Grade[]
  schoolStages                  SchoolStage[]
  sections                      Section[]
  subjects                      Subject[]
  curricula                     Curriculum[]
  lessons                       DailyLesson[]
  homework                      Homework[]
  quizzes                       Quiz[]
  announcements                 Announcement[]
  events                        Event[]
  notifications                 Notification[]
  invoices                      Invoice[]
  billingRecords                BillingRecord[]
  fileAssets                    FileAsset[]
  aiRequests                    AIRequest[]
  aiUsages                      AIUsage[]
  products                      Product[]
  orders                        Order[]
  auditLogs                     AuditLog[]
  apiExceptionLogs              ApiExceptionLog[]
  attendances                   Attendance[]
  teacherAttendances            TeacherAttendance[]
  staffAttendances              StaffAttendance[]
  feeStructures                 FeeStructure[]
  studentFees                   StudentFee[]
  homeDiaries                   HomeDiary[]
  reportCards                   ReportCard[]
  idCards                       IdCard[]
  teacherGradeStyles            TeacherGradeStyle[]
  expenses                      Expense[]
  quizTargets                   QuizTarget[]
  examConfigs                   ExamConfig[]
  examPaperAssignments          ExamPaperAssignment[]
  examDeadlineExtensionRequests ExamDeadlineExtensionRequest[]
  assessmentMarks               AssessmentMark[]
  timetableSlots                TimetableSlot[]
  reportCardTemplates           ReportCardTemplate[]
  headTeacherAssignments        HeadTeacherAssignment[]
  biometricDevices              BiometricDeviceConfig[]
  pendingBiometricPunches       PendingBiometricAttendanceLog[]
  ocrTrainingExamples           OcrTrainingExample[]
  libraryBooksCreated           LibraryBook[]                   @relation("LibraryBookOriginSchool")
  libraryBookGrants             LibraryBookGrant[]
  pricingPlanId                 String?                         @map("pricing_plan_id")
  pricingPlan                   PricingPlan?                    @relation(fields: [pricingPlanId], references: [id])
  schoolCalendarDays            SchoolCalendarDay[]
  timetableImports              TimetableImport[]
  timetableVersions             TimetableVersion[]
  academicPlanners              AcademicPlanner[]
  academicPlannerVersions       AcademicPlannerVersion[]
  plannerApprovalEvents         PlannerApprovalEvent[]
  teachingRecords               TeachingRecord[]
  classroomObservations         ClassroomObservation[]

  @@index([status])
  @@index([code])
  @@map("schools")
}

model Branch {
  id        String       @id @default(uuid())
  schoolId  String       @map("school_id")
  name      String
  code      String
  address   String?
  phone     String?
  status    BranchStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students        Student[]
  teachers        TeacherProfile[]
  sections        Section[]
  lessons         DailyLesson[]
  homework        Homework[]
  quizzes         Quiz[]
  announcements   Announcement[]
  events          Event[]
  invoiceItems    InvoiceItem[]
  billingRecords  BillingRecord[]
  products        Product[]
  inventory       Inventory[]
  orders          Order[]
  auditLogs       AuditLog[]
  attendances     Attendance[]
  teacherSubjects TeacherSubject[]
  classSubjects   ClassSubject[]
  academicYears   AcademicYear[]
  studentFees     StudentFee[]
  homeDiaries     HomeDiary[]
  reportCards     ReportCard[]
  idCards         IdCard[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@index([status])
  @@map("branches")
}

model SchoolSettings {
  id                       String   @id @default(uuid())
  schoolId                 String   @unique @map("school_id")
  timezone                 String   @default("Asia/Karachi")
  locale                   String   @default("en")
  maxQuizReminders         Int      @default(2) @map("max_quiz_reminders")
  academicYearStartMonth   Int      @default(8) @map("academic_year_start_month")
  setupCompleted           Boolean  @default(false) @map("setup_completed")
  examPattern              String?  @map("exam_pattern")
  lateFeeAmount            Decimal  @default(0) @map("late_fee_amount") @db.Decimal(12, 2)
  feeDueDay                Int      @default(10) @map("fee_due_day")
  teacherLateAfter         String   @default("08:15") @map("teacher_late_after") @db.VarChar(5)
  teacherAbsentAfter       String   @default("09:00") @map("teacher_absent_after") @db.VarChar(5)
  examSubmissionDaysBefore Int      @default(5) @map("exam_submission_days_before")
  metadata                 Json?
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_settings")
}

model PricingPlan {
  id                String   @id @default(uuid())
  name              String
  pricePerStudent   Decimal  @map("price_per_student") @db.Decimal(12, 2)
  currency          String   @default("PKR")
  minimumMonthlyFee Decimal  @map("minimum_monthly_fee") @db.Decimal(12, 2)
  active            Boolean  @default(true)
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  schools       School[]
  subscriptions SchoolSubscription[]

  @@map("pricing_plans")
}

model SchoolSubscription {
  id            String             @id @default(uuid())
  schoolId      String             @unique @map("school_id")
  pricingPlanId String             @map("pricing_plan_id")
  status        SubscriptionStatus @default(TRIAL)
  startsAt      DateTime           @map("starts_at")
  endsAt        DateTime?          @map("ends_at")
  trialEndsAt   DateTime?          @map("trial_ends_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  pricingPlan PricingPlan @relation(fields: [pricingPlanId], references: [id])

  @@index([pricingPlanId])
  @@index([status])
  @@map("school_subscriptions")
}

// ===================== PEOPLE =====================

model Student {
  id              String        @id @default(uuid())
  schoolId        String        @map("school_id")
  branchId        String        @map("branch_id")
  studentCode     String        @map("student_code")
  admissionNumber String        @map("admission_number")
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  dateOfBirth     DateTime?     @map("date_of_birth") @db.Date
  gender          Gender?
  status          StudentStatus @default(ACTIVE)
  photoUrl        String?       @map("photo_url")
  address         String?       @db.VarChar(255)
  scienceGroup    String?       @map("science_group")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  school          School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch          Branch                @relation(fields: [branchId], references: [id])
  parents         StudentParent[]
  enrollments     StudentEnrollment[]
  quizAttempts    QuizAttempt[]
  quizResults     QuizResult[]
  homeworkResults HomeworkResult[]
  attendances     Attendance[]
  dayOffRequests  ParentDayOffRequest[]
  photoAssets     StudentPhotoAsset[]
  quizAssignments QuizAssignment[]
  fees            StudentFee[]
  reportCards     ReportCard[]
  idCards         IdCard[]
  assessmentMarks AssessmentMark[]

  @@unique([schoolId, studentCode])
  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([branchId])
  @@index([status])
  @@map("students")
}

model ParentProfile {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  schoolId          String   @map("school_id")
  phone             String?
  relationshipNotes String?  @map("relationship_notes") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  school         School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students       StudentParent[]
  dayOffRequests ParentDayOffRequest[]

  @@index([schoolId])
  @@map("parent_profiles")
}

model StudentParent {
  id           String             @id @default(uuid())
  studentId    String             @map("student_id")
  parentId     String             @map("parent_id")
  relationship ParentRelationship @default(GUARDIAN)
  isPrimary    Boolean            @default(true) @map("is_primary")
  createdAt    DateTime           @default(now()) @map("created_at")

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
  @@map("student_parents")
}

model ParentDayOffRequest {
  id           String              @id @default(uuid())
  schoolId     String              @map("school_id")
  studentId    String              @map("student_id")
  parentId     String              @map("parent_id")
  startDate    DateTime            @map("start_date") @db.Date
  endDate      DateTime            @map("end_date") @db.Date
  reason       String              @db.Text
  status       DayOffRequestStatus @default(PENDING)
  reviewNote   String?             @map("review_note") @db.Text
  reviewedById String?             @map("reviewed_by_id")
  reviewedAt   DateTime?           @map("reviewed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent     ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("DayOffReviewedBy", fields: [reviewedById], references: [id])

  @@index([schoolId, status])
  @@index([studentId, startDate, endDate])
  @@index([parentId, createdAt])
  @@map("parent_day_off_requests")
}

model StudentPhotoAsset {
  id           String             @id @default(uuid())
  schoolId     String             @map("school_id")
  studentId    String             @map("student_id")
  fileAssetId  String             @map("file_asset_id")
  uploadedById String             @map("uploaded_by_id")
  status       StudentPhotoStatus @default(PENDING)
  reviewNote   String?            @map("review_note") @db.Text
  reviewedById String?            @map("reviewed_by_id")
  reviewedAt   DateTime?          @map("reviewed_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileAsset  FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation("StudentPhotoUploadedBy", fields: [uploadedById], references: [id])
  reviewedBy User?     @relation("StudentPhotoReviewedBy", fields: [reviewedById], references: [id])

  @@index([schoolId, status])
  @@index([studentId, createdAt])
  @@map("student_photo_assets")
}

model TeacherProfile {
  id           String        @id @default(uuid())
  userId       String        @unique @map("user_id")
  schoolId     String        @map("school_id")
  branchId     String        @map("branch_id")
  employeeCode String        @map("employee_code")
  hireDate     DateTime?     @map("hire_date") @db.Date
  gender       Gender?
  status       TeacherStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user                      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  school                    School                         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch                    Branch                         @relation(fields: [branchId], references: [id])
  teacherSubjects           TeacherSubject[]
  classSubjects             ClassSubject[]                 @relation("ClassSubjectPrimaryTeacher")
  assistantClassSubjects    ClassSubject[]                 @relation("ClassSubjectAssistantTeacher")
  lessons                   DailyLesson[]
  idCards                   IdCard[]
  gradeStyles               TeacherGradeStyle[]
  classSections             Section[]                      @relation("SectionClassTeacher")
  coordinatedStages         SchoolStage[]                  @relation("StageCoordinator")
  attendances               TeacherAttendance[]
  timetableSlots            TimetableSlot[]
