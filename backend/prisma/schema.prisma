model FeeStructure {
  id          String       @id @default(uuid())
  schoolId    String       @map("school_id")
  gradeId     String?      @map("grade_id")
  kind        FeeKind      @default(OTHER)
  name        String
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @default("PKR")
  frequency   FeeFrequency @default(MONTHLY)
  active      Boolean      @default(true)
  description String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade       Grade?       @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  studentFees StudentFee[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([gradeId])
  @@index([schoolId, gradeId, kind])
  @@map("fee_structures")
}

model StudentFee {
  id             String           @id @default(uuid())
  schoolId       String           @map("school_id")
  branchId       String           @map("branch_id")
  studentId      String           @map("student_id")
  feeStructureId String           @map("fee_structure_id")
  academicYearId String           @map("academic_year_id")
  sectionId      String?          @map("section_id")
  periodLabel    String           @map("period_label")
  amount         Decimal          @db.Decimal(12, 2)
  paidAmount     Decimal          @default(0) @map("paid_amount") @db.Decimal(12, 2)
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lateFeeAmount  Decimal          @default(0) @map("late_fee_amount") @db.Decimal(12, 2)
  lateFeeWaived  Boolean          @default(false) @map("late_fee_waived")
  dueDate        DateTime         @map("due_date") @db.Date
  status         StudentFeeStatus @default(DUE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  section      Section?     @relation(fields: [sectionId], references: [id])
  payments     FeePayment[]

  @@unique([studentId, feeStructureId, periodLabel])
  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("student_fees")
}

model FeePayment {
  id             String        @id @default(uuid())
  studentFeeId   String        @map("student_fee_id")
  amount         Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lateFeeAmount  Decimal       @default(0) @map("late_fee_amount") @db.Decimal(12, 2)
  lateFeeWaived  Boolean       @default(false) @map("late_fee_waived")
  receiptNumber  String?       @unique @map("receipt_number")
  method         PaymentMethod @default(CASH)
  reference      String?
  notes          String?
  paidAt         DateTime      @default(now()) @map("paid_at")
  recordedById   String        @map("recorded_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  studentFee StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("FeeRecordedBy", fields: [recordedById], references: [id])

  @@index([studentFeeId])
  @@index([receiptNumber])
  @@map("fee_payments")
}

