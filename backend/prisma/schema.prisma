  @@map("concepts")
}

// ===================== SHARED BOOK LIBRARY =====================

model LibraryBook {
  id                String   @id @default(uuid())
  catalogKey        String   @unique @map("catalog_key") @db.VarChar(255)
  title             String   @db.VarChar(255)
  publisher         String   @default("") @db.VarChar(255)
  classLabel        String   @default("") @map("class_label") @db.VarChar(120)
  subjectLabel      String   @default("") @map("subject_label") @db.VarChar(120)
  language          String   @default("English") @db.VarChar(20)
  editionYear       String?  @map("edition_year") @db.VarChar(20)
  createdByUserId   String   @map("created_by_user_id")
  createdBySchoolId String?  @map("created_by_school_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  createdBy        User                 @relation("LibraryBookCreatedBy", fields: [createdByUserId], references: [id])
  originSchool     School?              @relation("LibraryBookOriginSchool", fields: [createdBySchoolId], references: [id])
  chapters         LibraryBookChapter[]
  grants           LibraryBookGrant[]
  academicPlanners AcademicPlanner[]

  @@index([createdBySchoolId])
  @@map("library_books")
}

model LibraryBookChapter {
  id              String   @id @default(uuid())
  bookId          String   @map("book_id")
  chapterNumber   Int?     @map("chapter_number")
  title           String   @db.VarChar(255)
  topicName       String   @default("") @map("topic_name") @db.VarChar(255)
  publishedText   String   @map("published_text") @db.LongText
  exercisesText   String   @map("exercises_text") @db.LongText
  legacyLessonId  String?  @unique @map("legacy_lesson_id")
  addedByUserId   String   @map("added_by_user_id")
  addedBySchoolId String?  @map("added_by_school_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  book            LibraryBook      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  plannerChapters PlannerChapter[]
  teachingPack    LibraryChapterTeachingPack?

  @@unique([bookId, title])
  @@index([bookId])
  @@map("library_book_chapters")
}

/// AI-generated teaching metadata for a library chapter (shared across all planners using this chapter).
model LibraryChapterTeachingPack {
  id                   String                @id @default(uuid())
  libraryBookChapterId String                @unique @map("library_book_chapter_id")
  contentHash          String                @map("content_hash") @db.VarChar(64)
  complexity           String                @db.VarChar(16)
  summary              String                @db.Text
  teacherGuide         Json                  @map("teacher_guide")
  source               PlannerAnalysisSource
  warnings             Json?
  promptVersion        String                @map("prompt_version") @db.VarChar(64)
  generatedAt          DateTime              @map("generated_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  chapter        LibraryBookChapter            @relation(fields: [libraryBookChapterId], references: [id], onDelete: Cascade)
  readingSlices  LibraryChapterReadingSlice[]
  questions      LibraryChapterQuestionItem[]
  activities     LibraryChapterActivityItem[]
  revisionPoints LibraryChapterRevisionPoint[]

  @@index([contentHash])
  @@map("library_chapter_teaching_packs")
}

model LibraryChapterReadingSlice {
  id            String   @id @default(uuid())
  packId        String   @map("pack_id")
  sortOrder     Int      @map("sort_order")
  sliceKey      String   @map("slice_key") @db.VarChar(16)
  title         String   @db.VarChar(255)
  readingFrom   String   @map("reading_from") @db.Text
  readingTo     String?  @map("reading_to") @db.Text
  explainPoints Json     @map("explain_points")

  pack LibraryChapterTeachingPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@unique([packId, sliceKey])
  @@index([packId, sortOrder])
  @@map("library_chapter_reading_slices")
}

model LibraryChapterQuestionItem {
  id             String  @id @default(uuid())
  packId         String  @map("pack_id")
  sliceKey       String? @map("slice_key") @db.VarChar(16)
  sortOrder      Int     @map("sort_order")
  question       String  @db.Text
  expectedAnswer String  @map("expected_answer") @db.Text
  format         String  @db.VarChar(20)

  pack LibraryChapterTeachingPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, sortOrder])
  @@map("library_chapter_question_items")
}

model LibraryChapterActivityItem {
  id                     String  @id @default(uuid())
  packId                 String  @map("pack_id")
  sliceKey               String? @map("slice_key") @db.VarChar(16)
  sortOrder              Int     @map("sort_order")
  title                  String  @db.VarChar(255)
  description            String  @db.Text
  participationTechnique String  @map("participation_technique") @db.Text
  materials              String? @db.Text

  pack LibraryChapterTeachingPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, sortOrder])
  @@map("library_chapter_activity_items")
}

model LibraryChapterRevisionPoint {
  id        String  @id @default(uuid())
  packId    String  @map("pack_id")
  sliceKey  String? @map("slice_key") @db.VarChar(16)
  sortOrder Int     @map("sort_order")
  point     String  @db.Text

  pack LibraryChapterTeachingPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, sortOrder])
  @@map("library_chapter_revision_points")
}

model LibraryBookGrant {
  id              String   @id @default(uuid())
  bookId          String   @map("book_id")
  schoolId        String   @map("school_id")
  grantedByUserId String   @map("granted_by_user_id")
  canRead         Boolean  @default(true) @map("can_read")
  canWrite        Boolean  @default(false) @map("can_write")
  canUpdate       Boolean  @default(false) @map("can_update")
  canDelete       Boolean  @default(false) @map("can_delete")
  createdAt       DateTime @default(now()) @map("created_at")

  book   LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([bookId, schoolId])
  @@index([schoolId])
  @@map("library_book_grants")
}

/// Chapters a super admin deleted, so the next library open does not import them again.
model LibraryImportSkip {
  legacyLessonId String @id @map("legacy_lesson_id") @db.VarChar(191)

  @@map("library_import_skips")
}

// ===================== LESSONS =====================

model DailyLesson {
  id                 String                 @id @default(uuid())
  schoolId           String                 @map("school_id")
  branchId           String                 @map("branch_id")
  academicYearId     String                 @map("academic_year_id")
  gradeId            String                 @map("grade_id")
  sectionId          String                 @map("section_id")
  subjectId          String                 @map("subject_id")
  teacherId          String                 @map("teacher_id")
  createdById        String                 @map("created_by_id")
  date               DateTime               @db.Date
  chapterId          String?                @map("chapter_id")
  topicId            String?                @map("topic_id")
  chapterName        String?                @map("chapter_name")
  topicName          String?                @map("topic_name")
  teacherNotes       String?                @map("teacher_notes") @db.Text
  aiSummary          String?                @map("ai_summary") @db.Text
  pageFrom           Int?                   @map("page_from")
  pageTo             Int?                   @map("page_to")
  status             LessonStatus           @default(DRAFT)
  recordKind         LessonRecordKind       @default(CLASS_SESSION) @map("record_kind")
  sessionType        ClassSessionType?      @map("session_type")
  contentConfirmed   Boolean                @default(false) @map("content_confirmed")
  chapterProgress    ChapterProgressStatus? @map("chapter_progress")
  chapterSourceId    String?                @map("chapter_source_id")
  revisionChapterIds Json?                  @map("revision_chapter_ids")
  parentSummary      String?                @map("parent_summary") @db.Text
  confirmedAt        DateTime?              @map("confirmed_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch        Branch          @relation(fields: [branchId], references: [id])
  academicYear  AcademicYear    @relation(fields: [academicYearId], references: [id])
  grade         Grade           @relation(fields: [gradeId], references: [id])
  section       Section         @relation(fields: [sectionId], references: [id])
  subject       Subject         @relation(fields: [subjectId], references: [id])
  teacher       TeacherProfile  @relation(fields: [teacherId], references: [id])
  createdBy     User            @relation("LessonCreatedBy", fields: [createdById], references: [id])
  chapter       Chapter?        @relation(fields: [chapterId], references: [id])
  topic         Topic?          @relation(fields: [topicId], references: [id])
  chapterSource DailyLesson?    @relation("ClassSessionChapterSource", fields: [chapterSourceId], references: [id], onDelete: SetNull)
  classSessions DailyLesson[]   @relation("ClassSessionChapterSource")
  sources       LessonSource[]
  concepts      LessonConcept[]
  homework      Homework[]
  aiJobs        AIJob[]

  @@index([schoolId])
  @@index([branchId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([date])
  @@index([status])
  @@map("daily_lessons")
}

model LessonSource {
  id               String           @id @default(uuid())
  lessonId         String           @map("lesson_id")
  type             LessonSourceType
  fileAssetId      String?          @map("file_asset_id")
  ocrText          String?          @map("ocr_text") @db.LongText
  paddleOcrText    String?          @map("paddle_ocr_text") @db.LongText
  tesseractOcrText String?          @map("tesseract_ocr_text") @db.LongText
  mergedOcrText    String?          @map("merged_ocr_text") @db.LongText
  verifiedOcrText  String?          @map("verified_ocr_text") @db.LongText
  ocrReviewStatus  OcrReviewStatus  @default(NONE) @map("ocr_review_status")
  verifiedAt       DateTime?        @map("verified_at")
  verifiedByUserId String?          @map("verified_by_user_id")
  pageFrom         Int?             @map("page_from")
  pageTo           Int?             @map("page_to")
  manualText       String?          @map("manual_text") @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")

  lesson              DailyLesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  fileAsset           FileAsset?           @relation(fields: [fileAssetId], references: [id])
  verifiedBy          User?                @relation("LessonSourceVerifiedBy", fields: [verifiedByUserId], references: [id])
  ocrTrainingExamples OcrTrainingExample[]

  @@index([lessonId])
  @@index([ocrReviewStatus])
  @@map("lesson_sources")
}

model OcrTrainingExample {
  id               String                   @id @default(uuid())
  schoolId         String                   @map("school_id")
  lessonSourceId   String                   @map("lesson_source_id")
  fileAssetId      String?                  @map("file_asset_id")
  regionType       String                   @default("full_page") @map("region_type")
  label            String                   @db.LongText
  paddleText       String?                  @map("paddle_text") @db.LongText
  tesseractText    String?                  @map("tesseract_text") @db.LongText
  mergedText       String?                  @map("merged_text") @db.LongText
  splitGroup       String                   @map("split_group")
  status           OcrTrainingExampleStatus @default(APPROVED)
  approvedByUserId String?                  @map("approved_by_user_id")
  approvedAt       DateTime                 @default(now()) @map("approved_at")
  engineMeta       Json?                    @map("engine_meta")
  createdAt        DateTime                 @default(now()) @map("created_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessonSource LessonSource @relation(fields: [lessonSourceId], references: [id], onDelete: Cascade)
  fileAsset    FileAsset?   @relation(fields: [fileAssetId], references: [id])
  approvedBy   User?        @relation("OcrTrainingApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([schoolId])
  @@index([lessonSourceId])
  @@index([status])
  @@index([splitGroup])
  @@map("ocr_training_examples")
}

model OcrModelRelease {
  id             String              @id @default(uuid())
  role           OcrModelReleaseRole
  version        String
  artifactPath   String              @map("artifact_path")
  metrics        Json?
  datasetVersion String?             @map("dataset_version")
  promotedAt     DateTime?           @map("promoted_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  notes          String?             @db.Text

  @@index([role])
  @@index([version])
  @@map("ocr_model_releases")
}

model LessonConcept {
  id        String   @id @default(uuid())
  lessonId  String   @map("lesson_id")
  conceptId String?  @map("concept_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  lesson  DailyLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  concept Concept?    @relation(fields: [conceptId], references: [id])

  @@index([lessonId])
  @@index([conceptId])
  @@map("lesson_concepts")
}

// ===================== HOMEWORK =====================

model Homework {
  id             String    @id @default(uuid())
  schoolId       String    @map("school_id")
  branchId       String    @map("branch_id")
  academicYearId String    @map("academic_year_id")
  sectionId      String    @map("section_id")
  subjectId      String    @map("subject_id")
  lessonId       String?   @map("lesson_id")
  createdById    String    @map("created_by_id")
  title          String
  description    String?   @db.Text
  /// Teacher-only correct answers for review. Never sent to parents/students.
  answerKey      String?   @map("answer_key") @db.Text
  /// Auto-gradable items: [{ id, type, questionText, marks, correctAnswer, options? }]
  questionsJson  Json?     @map("questions_json")
  dueDate        DateTime  @map("due_date")
  publishedAt    DateTime? @map("published_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch       Branch               @relation(fields: [branchId], references: [id])
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  section      Section              @relation(fields: [sectionId], references: [id])
  subject      Subject              @relation(fields: [subjectId], references: [id])
  lesson       DailyLesson?         @relation(fields: [lessonId], references: [id])
  createdBy    User                 @relation("HomeworkCreatedBy", fields: [createdById], references: [id])
  attachments  HomeworkAttachment[]
  results      HomeworkResult[]

  @@index([schoolId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([dueDate])
  @@map("homework")
}

model HomeworkAttachment {
  id          String   @id @default(uuid())
  homeworkId  String   @map("homework_id")
  fileAssetId String   @map("file_asset_id")
  createdAt   DateTime @default(now()) @map("created_at")

  homework  Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id])

  @@index([homeworkId])
  @@map("homework_attachments")
}

model HomeworkResult {
  id          String   @id @default(uuid())
  homeworkId  String   @map("homework_id")
  studentId   String   @map("student_id")
  score       Decimal  @db.Decimal(8, 2)
  totalMarks  Decimal  @map("total_marks") @db.Decimal(8, 2)
  percentage  Decimal  @db.Decimal(5, 2)
  /// [{ questionId, optionId?, answerText?, isCorrect, marksAwarded }]
  answersJson Json     @map("answers_json")
  submittedAt DateTime @default(now()) @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([homeworkId])
  @@map("homework_results")
}

// ===================== ASSESSMENTS =====================

model Quiz {
  id                    String                @id @default(uuid())
  schoolId              String                @map("school_id")
  branchId              String                @map("branch_id")
  academicYearId        String                @map("academic_year_id")
  sectionId             String                @map("section_id")
  subjectId             String                @map("subject_id")
  title                 String
  description           String?               @db.Text
  status                QuizStatus            @default(DRAFT)
  publishedAt           DateTime?             @map("published_at")
  dueAt                 DateTime?             @map("due_at")
  createdById           String                @map("created_by_id")
  lessonDateFrom        DateTime?             @map("lesson_date_from") @db.Date
  lessonDateTo          DateTime?             @map("lesson_date_to") @db.Date
  totalMarks            Decimal               @default(0) @map("total_marks") @db.Decimal(8, 2)
  paperKind             String                @default("QUIZ") @map("paper_kind") @db.VarChar(32)
  difficulty            Int?
  examConfigId          String?               @map("exam_config_id")
  examPaperAssignmentId String?               @map("exam_paper_assignment_id")
  reviewStatus          ExamPaperReviewStatus @default(NOT_SUBMITTED) @map("review_status")
  rejectionReason       String?               @map("rejection_reason") @db.Text
  reviewedById          String?               @map("reviewed_by_id")
  reviewedAt            DateTime?             @map("reviewed_at")
  submittedAt           DateTime?             @map("submitted_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch              Branch               @relation(fields: [branchId], references: [id])
  academicYear        AcademicYear         @relation(fields: [academicYearId], references: [id])
  section             Section              @relation(fields: [sectionId], references: [id])
  subject             Subject              @relation(fields: [subjectId], references: [id])
  createdBy           User                 @relation("QuizCreatedBy", fields: [createdById], references: [id])
  reviewedBy          User?                @relation("QuizReviewedBy", fields: [reviewedById], references: [id])
  examConfig          ExamConfig?          @relation(fields: [examConfigId], references: [id], onDelete: SetNull)
  examPaperAssignment ExamPaperAssignment? @relation(fields: [examPaperAssignmentId], references: [id], onDelete: SetNull)
  questions           QuizQuestion[]
  assignments         QuizAssignment[]
  attempts            QuizAttempt[]
  results             QuizResult[]

  @@index([schoolId])
  @@index([sectionId])
  @@index([subjectId])
  @@index([status])
  @@index([paperKind])
  @@map("quizzes")
}

model QuizQuestion {
  id            String         @id @default(uuid())
  quizId        String         @map("quiz_id")
  type          QuestionType
  questionText  String         @map("question_text") @db.Text
  marks         Decimal        @db.Decimal(8, 2)
  correctAnswer String?        @map("correct_answer") @db.Text
  sectionLabel  String?        @map("section_label") @db.VarChar(32)
  order         Int            @default(0)
  source        QuestionSource @default(MANUAL)
  included      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizOption {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  optionText String   @map("option_text") @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  order      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

model QuizAssignment {
  id            String   @id @default(uuid())
  quizId        String   @map("quiz_id")
  sectionId     String?  @map("section_id")
  studentId     String?  @map("student_id")
  assignedAt    DateTime @default(now()) @map("assigned_at")
  reminderCount Int      @default(0) @map("reminder_count")
  createdAt     DateTime @default(now()) @map("created_at")

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id])

  @@index([quizId])
  @@index([sectionId])
  @@index([studentId])
  @@map("quiz_assignments")
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId      String    @map("quiz_id")
  studentId   String    @map("student_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  timeTaken   Int?      @map("time_taken")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id])
  answers QuizAnswer[]
  result  QuizResult?

  @@unique([quizId, studentId])
  @@index([quizId])
  @@index([studentId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id           String   @id @default(uuid())
  attemptId    String   @map("attempt_id")
  questionId   String   @map("question_id")
  answerText   String?  @map("answer_text") @db.Text
  optionId     String?  @map("option_id")
  isCorrect    Boolean? @map("is_correct")
  marksAwarded Decimal? @map("marks_awarded") @db.Decimal(8, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("quiz_answers")
}

model QuizResult {
  id          String   @id @default(uuid())
  quizId      String   @map("quiz_id")
  studentId   String   @map("student_id")
  attemptId   String   @unique @map("attempt_id")
  score       Decimal  @db.Decimal(8, 2)
  totalMarks  Decimal  @map("total_marks") @db.Decimal(8, 2)
  percentage  Decimal  @db.Decimal(5, 2)
  startedAt   DateTime @map("started_at")
  submittedAt DateTime @map("submitted_at")
  timeTaken   Int?     @map("time_taken")
  summary     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quiz    Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id])
  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([studentId])
  @@map("quiz_results")
}

// ===================== ATTENDANCE =====================

model Attendance {
  id             String           @id @default(uuid())
  schoolId       String           @map("school_id")
  branchId       String           @map("branch_id")
  academicYearId String           @map("academic_year_id")
  sectionId      String           @map("section_id")
  studentId      String           @map("student_id")
  date           DateTime         @db.Date
  status         AttendanceStatus
  notes          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([sectionId])
  @@index([date])
  @@map("attendances")
}

model TeacherAttendance {
  id                 String           @id @default(uuid())
  schoolId           String           @map("school_id")
  teacherId          String           @map("teacher_id")
  date               DateTime         @db.Date
  status             AttendanceStatus
  notes              String?
  checkedInAt        DateTime?        @map("checked_in_at")
  checkedOutAt       DateTime?        @map("checked_out_at")
  source             String           @default("ADMIN") @map("source") @db.VarChar(20)
  externalId         String?          @map("external_id") @db.VarChar(80)
  deviceUserId       String?          @map("device_user_id") @db.VarChar(80)
  deviceSerialNumber String?          @map("device_serial_number") @db.VarChar(80)
  recordedById       String?          @map("recorded_by_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  recordedBy User?          @relation("TeacherAttendanceRecordedBy", fields: [recordedById], references: [id])

  @@unique([teacherId, date])
  @@index([schoolId])
  @@index([teacherId])
  @@index([date])
  @@index([checkedInAt])
  @@map("teacher_attendances")
}

model StaffAttendance {
  id                 String           @id @default(uuid())
  schoolId           String           @map("school_id")
  userId             String           @map("user_id")
  date               DateTime         @db.Date
  status             AttendanceStatus
  notes              String?
  checkedInAt        DateTime?        @map("checked_in_at")
  checkedOutAt       DateTime?        @map("checked_out_at")
  source             String           @default("ADMIN") @map("source") @db.VarChar(20)
  deviceUserId       String?          @map("device_user_id") @db.VarChar(80)
  deviceSerialNumber String?          @map("device_serial_number") @db.VarChar(80)
  recordedById       String?          @map("recorded_by_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  school     School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User   @relation("StaffAttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy User?  @relation("StaffAttendanceRecordedBy", fields: [recordedById], references: [id])

  @@unique([userId, date])
  @@index([schoolId])
  @@index([userId])
  @@index([date])
  @@index([checkedInAt])
  @@map("staff_attendances")
}

model BiometricDeviceConfig {
  id                  String    @id @default(uuid())
  schoolId            String    @map("school_id")
  name                String
  ipAddress           String    @map("ip_address") @db.VarChar(45)
  port                Int       @default(4370)
  serialNumber        String?   @map("serial_number") @db.VarChar(80)
  isActive            Boolean   @default(true) @map("is_active")
  lastSyncAt          DateTime? @map("last_sync_at")
  syncIntervalSeconds Int       @default(300) @map("sync_interval_seconds")
  fullSyncRequestedAt DateTime? @map("full_sync_requested_at")
  deviceAdminUser     String?   @map("device_admin_user") @db.VarChar(80)
  deviceAdminPassword String?   @map("device_admin_password") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  school         School                          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  deviceUsers    BiometricDeviceUser[]
  mappings       BiometricDeviceUserMapping[]
  pendingPunches PendingBiometricAttendanceLog[]

  @@unique([schoolId, ipAddress, port])
  @@index([schoolId])
  @@map("biometric_device_configs")
}

model BiometricDeviceUser {
  id             String   @id @default(uuid())
  deviceConfigId String   @map("device_config_id")
  deviceUserId   String   @map("device_user_id") @db.VarChar(80)
  deviceUserName String?  @map("device_user_name") @db.VarChar(120)
  deviceBadgeId  String?  @map("device_badge_id") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  deviceConfig BiometricDeviceConfig @relation(fields: [deviceConfigId], references: [id], onDelete: Cascade)

  @@unique([deviceConfigId, deviceUserId])
  @@index([deviceConfigId])
  @@map("biometric_device_users")
}

model BiometricDeviceUserMapping {
  id             String   @id @default(uuid())
  deviceConfigId String   @map("device_config_id")
  teacherId      String?  @map("teacher_id")
  staffUserId    String?  @map("staff_user_id")
  deviceUserId   String   @map("device_user_id") @db.VarChar(80)
  deviceUserName String?  @map("device_user_name") @db.VarChar(120)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  deviceConfig BiometricDeviceConfig @relation(fields: [deviceConfigId], references: [id], onDelete: Cascade)
  teacher      TeacherProfile?       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  staffUser    User?                 @relation("BiometricStaffMapping", fields: [staffUserId], references: [id], onDelete: Cascade)

  @@unique([deviceConfigId, deviceUserId])
  @@unique([deviceConfigId, teacherId])
  @@unique([deviceConfigId, staffUserId], map: "bio_map_config_staff_user")
  @@index([deviceConfigId])
  @@index([teacherId])
  @@index([staffUserId])
  @@map("biometric_device_user_mappings")
}

model PendingBiometricAttendanceLog {
  id             String   @id @default(uuid())
  schoolId       String   @map("school_id")
  deviceConfigId String   @map("device_config_id")
  deviceUserId   String   @map("device_user_id") @db.VarChar(80)
  recordTime     DateTime @map("record_time")
  punchType      Int?     @map("punch_type")
  punchState     Int?     @map("punch_state")
  createdAt      DateTime @default(now()) @map("created_at")

  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  deviceConfig BiometricDeviceConfig @relation(fields: [deviceConfigId], references: [id], onDelete: Cascade)

  @@unique([deviceConfigId, deviceUserId, recordTime])
  @@index([schoolId])
  @@index([deviceConfigId, deviceUserId])
  @@map("pending_biometric_attendance_logs")
}

// ===================== COMMUNICATION =====================

model Announcement {
  id          String               @id @default(uuid())
  schoolId    String               @map("school_id")
  branchId    String?              @map("branch_id")
  gradeId     String?              @map("grade_id")
  sectionId   String?              @map("section_id")
  createdById String               @map("created_by_id")
  title       String
  description String               @db.Text
  audience    AnnouncementAudience @default(ALL_SCHOOL)
  publishAt   DateTime?            @map("publish_at")
  expiresAt   DateTime?            @map("expires_at")
  status      AnnouncementStatus   @default(DRAFT)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id])
  grade     Grade?   @relation(fields: [gradeId], references: [id])
  section   Section? @relation(fields: [sectionId], references: [id])
  createdBy User     @relation("AnnouncementCreatedBy", fields: [createdById], references: [id])

  @@index([schoolId])
  @@index([status])
  @@index([publishAt])
  @@map("announcements")
}

model Event {
  id          String               @id @default(uuid())
  schoolId    String               @map("school_id")
  branchId    String?              @map("branch_id")
  gradeId     String?              @map("grade_id")
  sectionId   String?              @map("section_id")
  createdById String               @map("created_by_id")
  title       String
  description String?              @db.Text
  type        EventType            @default(OTHER)
  startDate   DateTime             @map("start_date")
  endDate     DateTime             @map("end_date")
  location    String?
  audience    AnnouncementAudience @default(ALL_SCHOOL)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id])
  grade     Grade?   @relation(fields: [gradeId], references: [id])
  section   Section? @relation(fields: [sectionId], references: [id])
  createdBy User     @relation("EventCreatedBy", fields: [createdById], references: [id])

  @@index([schoolId])
  @@index([startDate])
  @@map("events")
}

model Notification {
  id        String           @id @default(uuid())
  schoolId  String?          @map("school_id")
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json?
  deepLink  String?          @map("deep_link")
  readAt    DateTime?        @map("read_at")
  sentAt    DateTime?        @map("sent_at")
  createdAt DateTime         @default(now()) @map("created_at")

  school School? @relation(fields: [schoolId], references: [id])
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([schoolId])
  @@index([type])
  @@index([readAt])
  @@map("notifications")
}

model NotificationPreference {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  type         NotificationType
  pushEnabled  Boolean          @default(true) @map("push_enabled")
  inAppEnabled Boolean          @default(true) @map("in_app_enabled")
  emailEnabled Boolean          @default(false) @map("email_enabled")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
