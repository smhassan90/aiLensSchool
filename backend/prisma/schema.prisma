// ===================== AI =====================

model AIRequest {
  id            String          @id @default(uuid())
  schoolId      String?         @map("school_id")
  userId        String?         @map("user_id")
  type          AIRequestType
  provider      String
  model         String
  inputTokens   Int             @default(0) @map("input_tokens")
  outputTokens  Int             @default(0) @map("output_tokens")
  estimatedCost Decimal         @default(0) @map("estimated_cost") @db.Decimal(12, 6)
  status        AIRequestStatus @default(PENDING)
  errorMessage  String?         @map("error_message") @db.Text
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  school School? @relation(fields: [schoolId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
  jobs   AIJob[]

  @@index([schoolId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("ai_requests")
}

model AIUsage {
  id            String   @id @default(uuid())
  schoolId      String   @map("school_id")
  period        String
  requestCount  Int      @default(0) @map("request_count")
  inputTokens   Int      @default(0) @map("input_tokens")
  outputTokens  Int      @default(0) @map("output_tokens")
  estimatedCost Decimal  @default(0) @map("estimated_cost") @db.Decimal(12, 6)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, period])
  @@index([schoolId])
  @@map("ai_usages")
}

model AIJob {
  id          String          @id @default(uuid())
  aiRequestId String?         @map("ai_request_id")
  lessonId    String?         @map("lesson_id")
  queueName   String          @map("queue_name")
  jobId       String?         @map("job_id")
  status      AIRequestStatus @default(PENDING)
  payload     Json?
  result      Json?
  error       String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  aiRequest AIRequest?   @relation(fields: [aiRequestId], references: [id])
  lesson    DailyLesson? @relation(fields: [lessonId], references: [id])

  @@index([aiRequestId])
  @@index([lessonId])
  @@index([status])
  @@map("ai_jobs")
}

// ===================== SHOP (foundation) =====================

model ProductCategory {
