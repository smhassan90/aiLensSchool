{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --include=dev && npx prisma generate",
  "buildCommand": "mkdir -p public && npx prisma generate",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "prisma/**",
      "excludeFiles": "{node_modules/@cursor/**,node_modules/sqlite3/**}"
    }
  }
}
