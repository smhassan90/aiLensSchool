# Backend
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1

# MySQL
DATABASE_URL="mysql://sms:smspassword@localhost:3306/school_management"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_URL=redis://localhost:6379

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Object Storage (S3-compatible). Leave empty to use local disk storage.
STORAGE_ENDPOINT=
STORAGE_BUCKET=sms-files
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
LOCAL_STORAGE_PATH=./uploads

# Push notifications (Expo)
EXPO_ACCESS_TOKEN=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Billing defaults are seeded via PricingPlan — do not hardcode in app code
THROTTLE_TTL=60
THROTTLE_LIMIT=100
