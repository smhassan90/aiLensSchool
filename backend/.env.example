# Backend
PORT=3001
NODE_ENV=development
API_PREFIX=api/v1

# MySQL (remote hosts: keep connection_limit modest; pool avoids reconnect storms)
DATABASE_URL="mysql://sms:smspassword@localhost:3306/sms?connection_limit=10&pool_timeout=30&connect_timeout=15"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRATION=30d
JWT_REFRESH_EXPIRATION=3650d

# Redis
REDIS_URL=redis://localhost:6379

# AI — Cursor is the default. Leave CURSOR_API_KEY empty to use local mocks.
# JSON tasks (quiz/homework) use composer-2.5-fast when CURSOR_MODEL=auto.
AI_PROVIDER=cursor
CURSOR_API_KEY=
CURSOR_MODEL=auto
CURSOR_JSON_MODEL=composer-2.5-fast
CURSOR_VISION_MODEL=composer-2.5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Object Storage (S3-compatible). Leave empty to use local disk storage.
STORAGE_ENDPOINT=
STORAGE_BUCKET=sms-files
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
LOCAL_STORAGE_PATH=./uploads

# Push notifications (Expo)
EXPO_ACCESS_TOKEN=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Debug: login as any PARENT with their username + this password (works even after they change theirs).
# Leave empty to disable.
PARENT_MASTER_PASSWORD=

# Billing defaults are seeded via PricingPlan — do not hardcode in app code
THROTTLE_TTL=60
THROTTLE_LIMIT=100
