# Copy to android/keystore.properties (never commit the real file).
# Generate upload keystore once:
#   keytool -genkeypair -v -storetype PKCS12 -keystore app/hawknexa-upload.keystore ^
#     -alias hawknexa-upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=hawknexa-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=hawknexa-upload
keyPassword=YOUR_KEY_PASSWORD
