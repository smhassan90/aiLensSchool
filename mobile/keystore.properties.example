# Legacy path: android/keystore.properties (generated by scripts/sync-android-signing.ps1).
# Prefer mobile/signing/play-upload.properties + play-upload.keystore instead.
#
# storeFile is relative to android/app/
storeFile=../../signing/play-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
