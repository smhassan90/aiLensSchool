# Portal (school admin, teacher, super admin)
hawknexa.fynals.com {
	encode gzip
	reverse_proxy portal:3000
}

# API (NestJS — /api/v1, /uploads, /api/docs)
hawknexabackend.fynals.com {
	encode gzip

	# GitHub Actions deploy trigger (Bearer token required)
	handle /internal/deploy* {
		reverse_proxy deploy-webhook:9000
	}

	handle {
		reverse_proxy backend:3001
	}
}

# Legacy Hostinger hostname → new portal domain
srv1984496.hstgr.cloud {
	redir https://hawknexa.fynals.com{uri} permanent
}

# Bare IP → portal
http://187.53.141.109 {
	redir https://hawknexa.fynals.com{uri} permanent
}
