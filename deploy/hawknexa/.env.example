# HawkNexa production — copy to /opt/apps/hawknexa/deploy/.env on the VPS.
# Database runs in Docker (service name: mysql). Do not point DATABASE_URL at a remote host.

# --- Docker MySQL (used by docker-compose.prod.yml) ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=hawknexa
MYSQL_USER=hawknexa
MYSQL_PASSWORD=change-me-db

# --- Public URLs (portal build + CORS) ---
PUBLIC_API_URL=https://hawknexabackend.fynals.com/api/v1
# Edge sync agent reads this via resolvePublicApiBaseUrl (PUBLIC_API_URL or PUBLIC_API_BASE_URL)
PUBLIC_API_BASE_URL=https://hawknexabackend.fynals.com/api/v1
CORS_ORIGINS=https://hawknexa.fynals.com,http://localhost:3000,http://127.0.0.1:3000

# --- Backend secrets (also read via env_file) ---
PORT=3001
NODE_ENV=production
API_PREFIX=api/v1
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long!
JWT_ACCESS_EXPIRATION=30d
JWT_REFRESH_EXPIRATION=3650d

# AI (optional)
AI_PROVIDER=cursor
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5

# Storage (local disk in container)
LOCAL_STORAGE_PATH=/app/uploads

# Push notifications (Firebase Cloud Messaging)
# Download a service-account key from the same Firebase project as mobile/google-services.json
# (project hawknexa-69fb8) and paste the full JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# First deploy only (optional)
RUN_SEED=false

# GitHub Actions deploy webhook (must match HAWKNEXA_DEPLOY_WEBHOOK_SECRET in GitHub)
DEPLOY_WEBHOOK_SECRET=change-me-deploy-webhook-secret
